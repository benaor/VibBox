#!/usr/bin/env bash
# =============================================================================
# VibBox - Entry Point CLI
# =============================================================================
#
# Description:
#   Script principal servant de point d'entrée pour VibBox.
#   Gère le parsing des arguments, le dispatch des commandes et l'orchestration
#   générale de l'application.
#
# Usage:
#   vibebox [command] [options]
#
# =============================================================================

set -euo pipefail

# =============================================================================
# RESOLVE SOURCE DIRECTORY
# Handle symlinks - compatible with both macOS and Linux
# =============================================================================

resolve_source_dir() {
    local source="${BASH_SOURCE[0]}"

    # Resolve symlinks - use readlink -f if available (Linux), otherwise loop (macOS)
    if command -v readlink &>/dev/null && readlink -f "$source" &>/dev/null; then
        source="$(readlink -f "$source")"
    else
        # macOS compatible symlink resolution
        while [[ -L "$source" ]]; do
            local dir
            dir="$(cd -P "$(dirname "$source")" && pwd)"
            source="$(readlink "$source")"
            # Handle relative symlinks
            [[ "$source" != /* ]] && source="$dir/$source"
        done
    fi

    # Get the directory containing the script
    cd -P "$(dirname "$source")" && pwd
}

VIBEBOX_SOURCE_DIR="$(resolve_source_dir)"

# =============================================================================
# SOURCE MODULES
# =============================================================================

# shellcheck source=lib/constants.sh
source "$VIBEBOX_SOURCE_DIR/lib/constants.sh"
# shellcheck source=lib/utils.sh
source "$VIBEBOX_SOURCE_DIR/lib/utils.sh"
# shellcheck source=lib/project.sh
source "$VIBEBOX_SOURCE_DIR/lib/project.sh"
# shellcheck source=lib/docker.sh
source "$VIBEBOX_SOURCE_DIR/lib/docker.sh"
# shellcheck source=lib/profiles.sh
source "$VIBEBOX_SOURCE_DIR/lib/profiles.sh"

# =============================================================================
# COMMANDS
# =============================================================================

# cmd_help - Display help message
cmd_help() {
    echo -e "${COLOR_BOLD}VibBox v${VIBEBOX_VERSION}${COLOR_NC} — Containerized Mistral Vibe Environment"
    echo ""
    echo -e "${COLOR_CYAN}USAGE:${COLOR_NC}"
    echo "    vibebox [command] [options]"
    echo ""
    echo -e "${COLOR_CYAN}COMMANDS:${COLOR_NC}"
    echo "    (default)        Launch Mistral Vibe in the container"
    echo "    shell            Open a zsh shell in the container"
    echo "    info             Show project and system information"
    echo "    build            Build the Docker image"
    echo "    rebuild          Clean rebuild the Docker image"
    echo "    clean            Remove project data and/or image"
    echo "    profiles         List available profiles"
    echo "    profile <name>   Install a profile (typescript, php)"
    echo "    profile status   Show installed profiles"
    echo "    install <pkg>    Install apt packages in the image"
    echo "    update           Update VibBox to latest version"
    echo "    help             Show this help"
    echo ""
    echo -e "${COLOR_CYAN}ENVIRONMENT:${COLOR_NC}"
    echo "    MISTRAL_API_KEY  Your Mistral API key (required for API usage)"
    echo "    OLLAMA_HOST      Ollama server URL (optional, for local models)"
    echo ""
    echo -e "${COLOR_CYAN}OLLAMA (local models):${COLOR_NC}"
    echo "    If Ollama is running on your host, VibBox auto-detects it."
    echo "    Inside the container, configure vibe to use it:"
    echo "      vibe --provider ollama --model devstral-small:24b"
    echo "    Or set it in ~/.vibe/config.toml"
    echo ""
}

# cmd_info - Display project and system information
cmd_info() {
    echo -e "${COLOR_BOLD}VibBox v${VIBEBOX_VERSION}${COLOR_NC}"
    echo ""

    echo -e "${COLOR_CYAN}Project:${COLOR_NC}"
    echo "    Name:       $PROJECT_NAME"
    echo "    Directory:  $(pwd)"
    echo "    Data dir:   $PROJECT_DATA_DIR"
    echo ""

    echo -e "${COLOR_CYAN}Docker:${COLOR_NC}"
    echo "    Image:      $IMAGE_NAME"
    if image_exists; then
        local created
        created="$(docker image inspect "$IMAGE_NAME" --format '{{.Created}}' 2>/dev/null | cut -d'T' -f1)"
        echo -e "    Status:     ${COLOR_GREEN}Built${COLOR_NC} ($created)"
    else
        echo -e "    Status:     ${COLOR_YELLOW}Not built${COLOR_NC}"
    fi
    echo ""

    echo -e "${COLOR_CYAN}System:${COLOR_NC}"
    echo "    OS:         $VIBEBOX_OS"
    echo "    Arch:       $VIBEBOX_ARCH"
    echo ""

    echo -e "${COLOR_CYAN}Profiles:${COLOR_NC}"
    if [[ -f "$PROJECT_PROFILES_FILE" ]] && [[ -s "$PROJECT_PROFILES_FILE" ]]; then
        while IFS= read -r line; do
            echo "    - $line"
        done < "$PROJECT_PROFILES_FILE"
    else
        echo "    (none installed)"
    fi
    echo ""

    echo -e "${COLOR_CYAN}Environment:${COLOR_NC}"
    if [[ -n "${MISTRAL_API_KEY:-}" ]]; then
        echo -e "    MISTRAL_API_KEY: ${COLOR_GREEN}Set${COLOR_NC}"
    else
        echo -e "    MISTRAL_API_KEY: ${COLOR_RED}Not set${COLOR_NC}"
    fi

    # Detect Ollama silently
    if detect_ollama 2>/dev/null; then
        echo -e "    Ollama:          ${COLOR_GREEN}Detected at ${OLLAMA_URL}${COLOR_NC}"
    else
        echo "    Ollama:          Not detected"
    fi
    echo ""
}

# cmd_clean - Interactive cleanup menu
cmd_clean() {
    echo -e "${COLOR_BOLD}Clean VibBox data${COLOR_NC}"
    echo ""
    echo "What would you like to remove?"
    echo ""
    echo "  1) Project data ($PROJECT_DATA_DIR)"
    echo "  2) Docker image ($IMAGE_NAME)"
    echo "  3) Both"
    echo "  4) Cancel"
    echo ""

    read -rp "Choice [1-4]: " choice

    case "$choice" in
        1)
            read -rp "Remove project data? [y/N]: " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                if safe_remove_project_data "$PROJECT_DATA_DIR"; then
                    log_ok "Project data removed: $PROJECT_DATA_DIR"
                fi
            else
                log_info "Cancelled"
            fi
            ;;
        2)
            read -rp "Remove Docker image? [y/N]: " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                remove_image
            else
                log_info "Cancelled"
            fi
            ;;
        3)
            read -rp "Remove project data AND Docker image? [y/N]: " confirm
            if [[ "$confirm" =~ ^[Yy]$ ]]; then
                if safe_remove_project_data "$PROJECT_DATA_DIR"; then
                    log_ok "Project data removed: $PROJECT_DATA_DIR"
                fi
                remove_image
            else
                log_info "Cancelled"
            fi
            ;;
        4|*)
            log_info "Cancelled"
            ;;
    esac
}

# cmd_install <packages...> - Install apt packages in the image
cmd_install() {
    if [[ $# -eq 0 ]]; then
        log_error "Usage: vibebox install <package> [package...]"
        exit 1
    fi

    # Store packages as an array to preserve proper quoting
    local -a packages=("$@")
    local temp_container="${CONTAINER_NAME}-install"

    # Validate each package name (Debian package naming: alphanumeric, +, -, ., starts with alnum)
    local pkg_regex='^[a-zA-Z0-9][a-zA-Z0-9+._-]*$'
    for pkg in "${packages[@]}"; do
        if [[ ! "$pkg" =~ $pkg_regex ]]; then
            log_error "Invalid package name: $pkg"
            log_error "Package names must start with alphanumeric and contain only [a-zA-Z0-9+._-]"
            exit 1
        fi
        # Length check to prevent abuse
        if [[ ${#pkg} -gt 128 ]]; then
            log_error "Package name too long: $pkg"
            exit 1
        fi
    done

    log_info "Installing packages: ${packages[*]}"

    # Cleanup function
    cleanup_install_container() {
        docker rm -f "$temp_container" &>/dev/null || true
    }
    trap cleanup_install_container EXIT

    # Start a temporary container
    docker run -d \
        --name "$temp_container" \
        "$IMAGE_NAME" \
        sleep infinity >/dev/null

    # Update apt index first
    if ! docker exec "$temp_container" sudo apt-get update; then
        log_error "Failed to update package index"
        cleanup_install_container
        trap - EXIT
        exit 1
    fi

    # Install packages - pass as separate quoted arguments (safe after validation)
    if docker exec "$temp_container" sudo apt-get install -y "${packages[@]}"; then
        # Commit changes to image
        docker commit "$temp_container" "$IMAGE_NAME" >/dev/null
        log_ok "Packages installed: ${packages[*]}"
    else
        log_error "Failed to install packages"
        cleanup_install_container
        trap - EXIT
        exit 1
    fi

    # Cleanup
    cleanup_install_container
    trap - EXIT
}

# ensure_image - Build image if it doesn't exist
ensure_image() {
    if ! image_exists; then
        log_info "Image not found, building..."
        build_image
    fi
}

# cmd_update - Update VibBox to latest version
cmd_update() {
    log_info "Updating VibBox..."
    if cd "$VIBEBOX_SOURCE_DIR" && git pull --quiet; then
        log_ok "VibBox updated to latest version"
    else
        log_error "Failed to update VibBox"
        return 1
    fi
}

# check_for_updates - Check if updates are available (non-blocking)
check_for_updates() {
    local last_check_file="$VIBEBOX_DIR/.last_update_check"

    # Skip if checked within last 24 hours
    if [[ -f "$last_check_file" ]]; then
        local last_check
        last_check=$(stat -c %Y "$last_check_file" 2>/dev/null || stat -f %m "$last_check_file" 2>/dev/null)
        local now
        now=$(date +%s)
        local diff=$((now - last_check))
        if [[ $diff -lt 86400 ]]; then
            return
        fi
    fi

    # Check for updates in background
    (
        cd "$VIBEBOX_SOURCE_DIR" 2>/dev/null || exit 0
        if git fetch --dry-run 2>&1 | grep -q .; then
            log_info "A new version of VibBox is available. Run 'vibebox update'"
        fi
        mkdir -p "$VIBEBOX_DIR"
        touch "$last_check_file"
    ) &
}

# =============================================================================
# MAIN
# =============================================================================

main() {
    # Detect system (redirect output, we only need the global vars)
    detect_os >/dev/null
    detect_arch >/dev/null

    # Initialize project vars (needed for most commands)
    init_project_vars

    # Check for updates in background (non-blocking)
    check_for_updates

    # Parse command
    local cmd="${1:-}"

    # Commands that don't require Docker
    case "$cmd" in
        help|--help|-h)
            cmd_help
            return
            ;;
        profiles)
            list_profiles
            return
            ;;
        update)
            cmd_update
            return
            ;;
    esac

    # All other commands require Docker
    ensure_docker
    ensure_project_dirs

    case "$cmd" in
        info)
            cmd_info
            ;;
        shell)
            ensure_image
            run_shell
            ;;
        build)
            build_image
            ;;
        rebuild)
            remove_image
            build_image
            ;;
        clean)
            cmd_clean
            ;;
        install)
            shift
            ensure_image
            cmd_install "$@"
            ;;
        profile)
            shift
            handle_profile "$@"
            ;;
        *)
            # Default: run vibe in container
            ensure_image

            # Warn if no API key
            if [[ -z "${MISTRAL_API_KEY:-}" ]]; then
                log_warn "MISTRAL_API_KEY is not set. API features will not work."
            fi

            run_container "$@"
            ;;
    esac
}

# Run main with all arguments
main "$@"
